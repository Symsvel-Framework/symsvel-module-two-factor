{
    "name": "symsvel-framework/module-two-factor",
    "description": "Optional native TOTP and recovery-code second-factor module for SymSvel",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-sodium": "*",
        "symfony/framework-bundle": "^8.1",
        "doctrine/dbal": "^4.3",
        "symsvel-framework/module-auth": "^1.0",
        "symsvel-framework/module-settings": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "SymSvel\\Module\\TwoFactor\\": "back/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SymSvel\\Module\\TwoFactor\\Tests\\": "back/tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "doctrine/orm": "^3.5",
        "symsvel-framework/module-acls": "^1.0",
        "symsvel-framework/module-mails": "^1.0"
    },
    "scripts": {
        "test": "phpunit -c back/phpunit.xml.dist",
        "qa": [
            "@test"
        ]
    },
    "extra": {
        "symsvel-module": {
            "manifest": "module.json"
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev",
            "dev-dev": "1.0.x-dev"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Symsvel-Framework/symsvel-module-auth.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Symsvel-Framework/symsvel-module-settings.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Symsvel-Framework/symsvel-module-acls.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Symsvel-Framework/symsvel-module-mails.git"
        }
    ]
}
