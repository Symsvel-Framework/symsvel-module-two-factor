{
    "name": "symsvel-framework/module-2fa",
    "description": "SymSvel module 2fa",
    "type": "symfony-bundle",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "symfony/framework-bundle": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "SymSvel\\Module\\2fa\\": "back/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SymSvel\\Module\\2fa\\Tests\\": "back/tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "scripts": {
        "test": "phpunit -c back/phpunit.xml.dist",
        "qa": [
            "@test"
        ]
    },
    "extra": {
        "symsvel-module": {
            "manifest": "module.json"
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    }
}
